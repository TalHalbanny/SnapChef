rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{id} {
      allow read, write: if true;
    }
    match /recipes/{id} {
      allow read, write: if true;
    }
    match /reviews/{id} {
      allow read, write: if true;
    }
    match /ingredient_usage/{id} {
      allow read, write: if true;
    }
  }
}
